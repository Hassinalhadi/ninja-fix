<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/textView33"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_12"
        android:text="@string/you_ve_earned_a_bonus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Headline6"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:gravity="center"
        android:id="@+id/textView32"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_6"
        android:alpha="0.6"
        android:layout_marginStart="@dimen/spacing_6"
        android:layout_marginEnd="@dimen/spacing_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView33"
        style="@style/Body2"/>
    <ImageView
        android:id="@+id/imageView7"
        android:background="@drawable/wallet_balance_box_bg"
        android:padding="@dimen/spacing_25"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="@dimen/spacing_zero"
        android:layout_margin="@dimen/spacing_12"
        android:src="@drawable/ic_gift_illustration"
        android:scaleType="center"
        android:backgroundTint="@color/color_light_blue"
        app:layout_constraintBottom_toTopOf="@+id/btnThankYou"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="@dimen/spacing_192"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView32"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@android:color/white"
        android:id="@+id/btnThankYou"
        android:padding="@dimen/spacing_12"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_12"
        android:text="@string/ok_thank_you"
        android:textAllCaps="false"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="@dimen/spacing_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textStyle="bold"
        android:textColor="@color/colorRed"
        android:id="@+id/tvBonusAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/imageView7"
        app:layout_constraintEnd_toEndOf="@+id/imageView7"
        app:layout_constraintStart_toStartOf="@+id/imageView7"
        app:layout_constraintTop_toTopOf="@+id/imageView7"
        app:layout_constraintVertical_bias="0.459"
        style="@style/TextAppearance.MaterialComponents.Headline4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
