<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bottom_sheet_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageButton
        android:id="@+id/btnClose"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/spacing_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:contentDescription="@string/close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_baseline_close_24"
        app:tint="@color/black"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnClose">
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:id="@+id/btnCall"
            android:paddingTop="@dimen/spacing_9"
            android:paddingBottom="@dimen/spacing_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/phone"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_4"
            android:paddingVertical="@dimen/spacing_9"
            app:icon="@drawable/ic_call_icon"
            style="@style/OrderProcessingTextActionButtonStyle2"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:id="@+id/btnWhatsapp"
            android:padding="@dimen/spacing_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/whatsapp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_4"
            style="@style/OrderProcessingTextActionButtonStyle2"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
