<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_platform_selection_0"
    android:padding="@dimen/spacing_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_6">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivImage"
        android:tag="binding_1"
        android:layout_width="@dimen/spacing_18"
        android:layout_height="@dimen/spacing_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@color/black"
        android:id="@+id/tvPlatformName"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_6"
        app:layout_constraintStart_toEndOf="@+id/ivImage"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iconFavorite"
        android:tag="binding_3"
        android:layout_width="@dimen/spacing_18"
        android:layout_height="@dimen/spacing_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvUnavailableTag"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/pink"
        app:cardCornerRadius="@dimen/spacing_54"
        app:cardElevation="@dimen/spacing_zero"
        app:contentPaddingBottom="@dimen/spacing_3"
        app:contentPaddingLeft="@dimen/spacing_5"
        app:contentPaddingRight="@dimen/spacing_5"
        app:contentPaddingTop="@dimen/spacing_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unavailable"/>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
