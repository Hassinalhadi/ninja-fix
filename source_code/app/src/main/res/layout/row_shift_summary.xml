        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_return"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/summary_return"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_disconnected_val"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="#dfbd46"
        android:gravity="center"
        android:id="@+id/tv_return_count"
        android:tag="binding_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_return"
        app:layout_constraintStart_toStartOf="@+id/tv_return"
        app:layout_constraintTop_toBottomOf="@+id/tv_return"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="#dfbd46"
        android:gravity="center"
        android:id="@+id/tv_return_percentage"
        android:tag="binding_13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_return"
        app:layout_constraintStart_toStartOf="@+id/tv_return"
        app:layout_constraintTop_toBottomOf="@+id/tv_return_count"/>
