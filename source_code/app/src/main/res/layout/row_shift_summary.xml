        android:textStyle="bold"
        android:textColor="#3002c6"
        android:id="@+id/tv_roaming_val"
        android:tag="binding_6"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_slack_time"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@color/black"
        android:id="@+id/tv_disconnected"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:text="@string/disconnected_minutes"
        android:layout_marginStart="@dimen/spacing_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_roaming"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textStyle="bold"
        android:textColor="#a400e0"
        android:id="@+id/tv_disconnected_val"
        android:tag="binding_7"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_6"
        app:layout_constraintStart_toEndOf="@+id/tv_disconnected"
        app:layout_constraintTop_toBottomOf="@+id/tv_roaming"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_pickup"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/summary_pick_up"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_disconnected_val"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="#6d1464"
        android:gravity="center"
        android:id="@+id/tv_pickup_count"
        android:tag="binding_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_pickup"
        app:layout_constraintStart_toStartOf="@+id/tv_pickup"
        app:layout_constraintTop_toBottomOf="@+id/tv_pickup"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="#6d1464"
        android:gravity="center"
        android:id="@+id/tv_pickup_percentage"
        android:tag="binding_9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_pickup"
        app:layout_constraintStart_toStartOf="@+id/tv_pickup"
        app:layout_constraintTop_toBottomOf="@+id/tv_pickup_count"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_delivery"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/summary_delivery"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_disconnected_val"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="#5e899e"
        android:gravity="center"
        android:id="@+id/tv_delivery_count"
        android:tag="binding_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_delivery"
        app:layout_constraintStart_toStartOf="@+id/tv_delivery"
        app:layout_constraintTop_toBottomOf="@+id/tv_delivery"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="#5e899e"
        android:gravity="center"
        android:id="@+id/tv_delivery_percentage"
        android:tag="binding_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_delivery"
        app:layout_constraintStart_toStartOf="@+id/tv_delivery"
        app:layout_constraintTop_toBottomOf="@+id/tv_delivery_count"/>
