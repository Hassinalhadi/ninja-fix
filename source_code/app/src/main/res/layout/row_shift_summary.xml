        android:textSize="@dimen/text_size_xxx_small"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_total_delivered"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/shift_summary_delivered_orders"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pickup_percentage"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="@color/zui_color_red_600"
        android:gravity="center"
        android:id="@+id/tv_delivered_orders_ct"
        android:tag="binding_14"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_total_delivered"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_earnings_dis"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/shift_summary_earnings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_delivered_orders_ct"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="@color/colorGreen"
        android:gravity="center"
        android:id="@+id/tv_earnings"
        android:tag="binding_15"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_earnings_dis"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_total_collected_cash"
        android:tag="binding_16"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/total_collected_cash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_earnings"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="@color/colorGreen"
        android:gravity="center"
        android:id="@+id/tv_total_collected_cash_val"
        android:tag="binding_17"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_total_collected_cash"/>
</androidx.constraintlayout.widget.ConstraintLayout>
