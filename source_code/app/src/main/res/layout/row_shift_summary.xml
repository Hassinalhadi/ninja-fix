        android:layout_marginStart="@dimen/spacing_6"
        app:layout_constraintStart_toEndOf="@+id/tv_delay_minutes"
        app:layout_constraintTop_toBottomOf="@+id/tv_slack_time"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@color/black"
        android:id="@+id/tv_roaming"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:text="@string/roaming_minutes"
        android:layout_marginEnd="@dimen/spacing_6"
        app:layout_constraintEnd_toStartOf="@+id/tv_roaming_val"
        app:layout_constraintTop_toBottomOf="@+id/tv_slack_time"/>
