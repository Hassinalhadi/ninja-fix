<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_shift_summary_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_12"
    android:foreground="?attr/selectableItemBackground"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="@dimen/spacing_zero"
        app:cardBackgroundColor="@color/color_light_blue"
        app:cardCornerRadius="@dimen/spacing_6"
        app:cardElevation="@dimen/spacing_zero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textColor="@color/darker_gray"
        android:tag="binding_1"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_area"
        android:tag="binding_2"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@color/black"
        android:id="@+id/tv_busy_time_dis"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/shift_started_at"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_area"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textStyle="bold"
        android:textColor="@color/colorOrange"
        android:tag="binding_3"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        app:layout_constraintStart_toEndOf="@+id/tv_busy_time_dis"
        app:layout_constraintTop_toBottomOf="@+id/tv_area"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textStyle="bold"
        android:textColor="@color/color_royal_blue"
        android:id="@+id/tv_slack_time"
        android:tag="binding_4"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_area"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@color/black"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/started_at"
        app:layout_constraintEnd_toStartOf="@+id/tv_slack_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_area"/>
