<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/linearLayoutSignOut"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true">
    <View
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_1"
        android:alpha="0.2"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textStyle="bold"
        android:gravity="start|center_vertical"
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_logout"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_12"
        app:icon="@drawable/ic_logout_icon"
        app:iconPadding="@dimen/spacing_12"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</LinearLayout>
