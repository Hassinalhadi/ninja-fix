<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/tick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_69"
        android:src="@drawable/ic_done_all_24"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/colorGreen"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tick"
        app:layout_constraintVertical_bias="0">
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/spacing_25"
            android:text="@string/your_request_is_submitted_successfully_you_will_be_notified_soon"
            android:alpha="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
