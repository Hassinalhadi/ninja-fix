<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_completed_order_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView2"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="@dimen/spacing_zero"
            app:cardBackgroundColor="@color/color_light_blue"
            app:cardCornerRadius="@dimen/spacing_6"
            app:cardElevation="@dimen/spacing_zero"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textStyle="bold"
            android:id="@+id/tvDate"
            android:tag="binding_1"
            android:padding="@dimen/spacing_6"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            app:layout_constraintEnd_toStartOf="@+id/tvAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Body2"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textStyle="bold"
            android:gravity="end"
            android:id="@+id/tvAmount"
            android:tag="binding_2"
            android:padding="@dimen/spacing_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvDate"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Body2"/>
        <View
            android:id="@+id/view2"
            android:background="#1a000000"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="@dimen/spacing_1"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_marginStart="@dimen/spacing_6"
            android:layout_marginEnd="@dimen/spacing_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDate"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textColor="@color/black_40"
            android:gravity="center"
            android:id="@+id/lbOrderBackendNo"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/order"
            android:layout_marginStart="@dimen/spacing_12"
            app:layout_constraintEnd_toStartOf="@+id/lbStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view2"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textColor="@color/black_40"
            android:gravity="center"
            android:id="@+id/lbStatus"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/status"
            app:layout_constraintEnd_toStartOf="@+id/lbPaymentType"
            app:layout_constraintStart_toEndOf="@+id/lbOrderBackendNo"
            app:layout_constraintTop_toBottomOf="@+id/view2"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textColor="@color/black_40"
            android:gravity="center"
            android:id="@+id/lbPaymentType"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/payment"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/lbStatus"
            app:layout_constraintTop_toBottomOf="@+id/view2"/>
        <TextView
            android:textSize="@dimen/text_size_xxx_small"
            android:textStyle="bold"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/backendNo"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:singleLine="true"
            android:layout_marginStart="@dimen/spacing_12"
            android:textFontWeight="600"
            app:layout_constraintEnd_toStartOf="@+id/tvStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lbOrderBackendNo"
            style="@style/Body2"/>
        <TextView
            android:textSize="@dimen/text_size_xxx_small"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tvStatus"
            android:tag="binding_3"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:textFontWeight="600"
            app:layout_constraintEnd_toStartOf="@+id/tvPaymentType"
            app:layout_constraintStart_toEndOf="@+id/backendNo"
            app:layout_constraintTop_toTopOf="@+id/tvPaymentType"
            style="@style/Body2"/>
        <TextView
            android:textSize="@dimen/text_size_xxx_small"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tvPaymentType"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_12"
            android:textFontWeight="600"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvStatus"
            app:layout_constraintTop_toTopOf="@+id/backendNo"
            style="@style/Body2"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:background="@drawable/rounded_box"
            android:padding="@dimen/spacing_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_12"
            android:backgroundTint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPaymentType">
            <ImageView
                android:id="@+id/imageView3"
                android:tag="binding_4"
                android:background="@drawable/rounded_box"
                android:layout_width="@dimen/spacing_37"
                android:layout_height="@dimen/spacing_37"
                android:layout_margin="@dimen/spacing_6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:ellipsize="marquee"
                android:id="@+id/orderFromLb"
                android:layout_width="@dimen/spacing_zero"
                android:layout_height="wrap_content"
                android:text="@string/pickup_from"
                android:singleLine="true"
                android:layout_marginStart="@dimen/spacing_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView3"
                app:layout_constraintTop_toTopOf="@+id/imageView3"
                style="@style/Body1"/>
            <TextView
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:ellipsize="marquee"
                android:gravity="start"
                android:id="@+id/orderFrom"
                android:tag="binding_5"
                android:layout_width="@dimen/spacing_zero"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                app:layout_constraintBottom_toBottomOf="@+id/imageView3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/orderFromLb"
                style="@style/Body3"/>
            <View
                android:id="@+id/separator"
                android:tag="binding_6"
                android:background="#1a000000"
                android:layout_width="@dimen/spacing_zero"
                android:layout_height="@dimen/spacing_1"
                android:layout_marginTop="@dimen/spacing_6"
                android:layout_marginStart="@dimen/spacing_6"
                android:layout_marginEnd="@dimen/spacing_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView3"/>
            <ImageView
                android:id="@+id/imageView4"
                android:tag="binding_7"
                android:background="@drawable/rounded_box"
                android:layout_width="@dimen/spacing_37"
                android:layout_height="@dimen/spacing_37"
                android:layout_margin="@dimen/spacing_6"
                android:layout_marginTop="@dimen/spacing_6"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separator"
                app:srcCompat="@drawable/ic_location_pin_24"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:ellipsize="marquee"
                android:id="@+id/orderToLb"
                android:tag="binding_8"
                android:layout_width="@dimen/spacing_zero"
                android:layout_height="wrap_content"
                android:text="@string/deliver_to"
                android:singleLine="true"
                android:layout_marginStart="@dimen/spacing_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView4"
                app:layout_constraintTop_toTopOf="@+id/imageView4"
                style="@style/Body1"/>
            <TextView
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:ellipsize="marquee"
                android:gravity="start"
                android:id="@+id/orderTo"
                android:tag="binding_9"
                android:layout_width="@dimen/spacing_zero"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                app:layout_constraintBottom_toBottomOf="@+id/imageView4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/orderToLb"
                style="@style/Body3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:id="@+id/btnSeeDetails"
            android:padding="@dimen/spacing_9"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_marginBottom="@dimen/spacing_12"
            android:text="@string/check_full_details"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout"
            style="@style/OrderProcessingTextActionButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
