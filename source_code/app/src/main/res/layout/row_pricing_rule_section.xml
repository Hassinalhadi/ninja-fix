<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_6"
    android:layout_marginBottom="@dimen/spacing_6"
    android:layout_marginStart="@dimen/spacing_12"
    android:layout_marginEnd="@dimen/spacing_12"
    app:cardCornerRadius="@dimen/spacing_6"
    app:cardElevation="@dimen/spacing_zero">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/header_bar"
            android:background="@color/location_info_blue"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/tv_category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/pricing_category_title"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="@+id/header_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/header_bar"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/table_header"
            android:background="@color/cool_gray"
            android:padding="@dimen/spacing_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:weightSum="4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_bar">
            <TextView
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/tv_header_rule_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/rule_name"
                android:layout_weight="2"/>
            <TextView
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/tv_header_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/tv_header_condition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/condition"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_rules"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/table_header"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
