<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true">
                    <ImageView
                        android:id="0x7f091ca4"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginBottom="10dp"
                        android:src="@drawable/WhatsApps"
                        android:onClick="onClickWhatsApp"/>
                    <ImageView
                        android:id="0x7f091ca7"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/Telegram"
                        android:onClick="onClickTelegram"/>
                </LinearLayout>
                <RelativeLayout
                    android:id="0x7f091ca8"
                    android:padding="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:src="@drawable/bingkai_selfie"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">
                    <ImageView
                        android:id="@+id/Facebook"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginBottom="10dp"
                        android:src="@drawable/Facebook"
                        android:onClick="onClickFacebook"/>
                    <ImageView
                        android:id="@+id/Telegram"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/Instagram"
                        android:onClick="onClickInstagram"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextClock
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/TimeIsWait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, MMM dd, yyyy h:mm a"
                    android:format24Hour="EEEE, dd MMM yyyy HH:mm"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:weightSum="1">
                <Switch
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/accessibility_custom_action_13"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="𝐀𝐜𝐜𝐞𝐩𝐭 𝐎𝐫𝐝𝐞𝐫𝐬 𝐁𝐲 𝐒𝐲𝐬𝐭𝐞𝐦 𝐀𝐫𝐜𝐡𝐞𝐫𝐬"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:weightSum="1">
                <Switch
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/accessibility_custom_action_14"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="𝐀𝐜𝐜𝐞𝐩𝐭 𝐎𝐫𝐝𝐞𝐫𝐬 𝐁𝐲 𝐃𝐢𝐬𝐭𝐚𝐧𝐜𝐞 𝐌𝐢𝐧-𝐌𝐚𝐱 𝐀𝐫𝐜𝐡𝐞𝐫"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <EditText
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:textColorHint="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/accessibility_custom_action_15"
                        android:background="@drawable/ic_DaghughMougraphTreple"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0"
                        android:layout_alignParentEnd="false"/>
                </RelativeLayout>
                <View
                    android:background="#ff000000"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <EditText
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:textColorHint="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/accessibility_custom_action_16"
                        android:background="@drawable/ic_DaghughMougraphTreple"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0"
                        android:layout_alignParentEnd="false"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:padding="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:weightSum="1">
                <Switch
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/accessibility_custom_action_17"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="𝐀𝐜𝐜𝐞𝐩𝐭 𝐎𝐫𝐝𝐞𝐫𝐬 𝐁𝐲 𝐏𝐫𝐢𝐜𝐞 𝐌𝐢𝐧-𝐌𝐚𝐱"
                    android:layoutDirection="locale"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <EditText
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:textColorHint="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/accessibility_custom_action_18"
                        android:background="@drawable/ic_DaghughMougraphTreple"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="5"
                        android:layout_alignParentEnd="false"/>
                </RelativeLayout>
                <View
                    android:background="#ff000000"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <EditText
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:textColorHint="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/accessibility_custom_action_19"
                        android:background="@drawable/ic_DaghughMougraphTreple"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0"
                        android:layout_alignParentEnd="false"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:padding="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:weightSum="1">
                <Switch
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/ShowMaps"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="𝐀𝐫𝐜𝐡𝐞𝐫𝐬 Refresh Auto"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <EditText
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:textColorHint="#ffffffff"
                        android:gravity="center"
                        android:id="@+id/Refresh1"
                        android:background="@drawable/ic_DaghughMougraphTreple"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="100"
                        android:layout_alignParentEnd="false"/>
                </RelativeLayout>
                <View
                    android:background="#ff000000"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:background="@drawable/ic_DaghughMougraphTreple"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Speed Ms"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:padding="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:weightSum="1">
                <Switch
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@+id/ShowMpasss2"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Delivery Addres"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/SaveSetting"
                android:background="@drawable/ic_DaghughMougraphTreple"
                android:padding="10dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="SAVE SETTINGS"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
