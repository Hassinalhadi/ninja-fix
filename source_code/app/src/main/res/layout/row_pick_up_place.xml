<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:tag="layout/row_pick_up_place_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/tvPaymentType">
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textStyle="bold"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pickup_from"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Body2"/>
    <ImageView
        android:id="@+id/imageView3"
        android:background="@drawable/rounded_box"
        android:layout_width="@dimen/spacing_37"
        android:layout_height="@dimen/spacing_37"
        android:layout_marginTop="@dimen/spacing_6"
        android:src="@drawable/ic_location_pin_24"
        android:scaleType="center"
        android:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:ellipsize="marquee"
        android:id="@+id/orderFromLb"
        android:tag="binding_1"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/spacing_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView3"
        app:layout_constraintTop_toTopOf="@+id/imageView3"
        style="@style/Body2_medium"/>
    <RelativeLayout
        android:id="@+id/rl_eta"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/orderFromLb"
        app:layout_constraintTop_toBottomOf="@+id/orderFromLb">
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:id="@+id/tv_eta_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expected_eta"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/spacing_9"
            android:layout_toEndOf="@+id/tv_eta_desc"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:id="@+id/tv_actual_eta_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/actual_eta"
            android:layout_below="@+id/tv_eta_desc"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_actual_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_eta"
            android:layout_marginStart="@dimen/spacing_9"
            android:layout_toEndOf="@+id/tv_actual_eta_desc"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
