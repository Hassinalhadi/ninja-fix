<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_25"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_location_pin_24"/>
            <TextView
                android:textSize="@dimen/text_size_xx_large"
                android:gravity="center"
                android:id="@+id/textView26"
                android:layout_width="@dimen/spacing_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/use_your_location"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView5"
                style="@style/Headline6"/>
            <TextView
                android:textSize="@dimen/text_size_medium"
                android:gravity="center"
                android:id="@+id/tvInfoWhyNeedLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_25"
                android:text="@string/to_see_maps_for_automatically_tracked_activities_allow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView26"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/colorPrimary"
                android:id="@+id/btnHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/need_help"
                android:textAllCaps="false"
                app:icon="@drawable/ic_info_icon"
                app:iconGravity="textStart"
                app:iconTint="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvInfoWhyNeedLocation"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWarningBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginStart="@dimen/spacing_25"
                android:layout_marginEnd="@dimen/spacing_25"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnHelp">
                <TextView
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/tvPreciseLocationWarning"
                    android:background="@drawable/bg_warning_banner"
                    android:padding="@dimen/spacing_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/precise_location_warning"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_location_pin_24"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llStepIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:layout_marginStart="@dimen/spacing_25"
                android:layout_marginEnd="@dimen/spacing_25"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardWarningBanner">
                <TextView
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tvStepIndicator"
                    android:background="@drawable/bg_gradient_location_info"
                    android:paddingLeft="12dp"
                    android:paddingTop="6dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_indicator_format"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tvStepInstructions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/location_permission_steps"
                android:layout_marginStart="@dimen/spacing_25"
                android:layout_marginEnd="@dimen/spacing_25"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llStepIndicator"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/clLocationComparison"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:layout_marginStart="@dimen/spacing_25"
                android:layout_marginEnd="@dimen/spacing_25"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvStepInstructions">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_precise_location"
                        android:padding="@dimen/spacing_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_location_pin_24"
                            android:tint="@color/location_success_green"/>
                        <TextView
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            android:textColor="@color/location_success_green_dark"
                            android:gravity="center"
                            android:id="@+id/tvPreciseLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/precise_location_label"/>
                        <TextView
                            android:textSize="@dimen/text_size_xx_tiny_extra"
                            android:textColor="@color/grey_700"
                            android:gravity="center"
                            android:id="@+id/tvPreciseDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/precise_location_description"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_approximate_location"
                        android:padding="@dimen/spacing_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_location_pin_24"
                            android:tint="@color/location_error_red"/>
                        <TextView
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            android:textColor="@color/location_error_red_dark"
                            android:gravity="center"
                            android:id="@+id/tvApproximateLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/approximate_location_label"/>
                        <TextView
                            android:textSize="@dimen/text_size_xx_tiny_extra"
                            android:textColor="@color/grey_700"
                            android:gravity="center"
                            android:id="@+id/tvApproximateDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/approximate_location_description"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_25"
                android:layout_marginBottom="@dimen/spacing_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clLocationComparison"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@android:color/black"
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_12"
        android:text="@android:string/cancel"
        android:backgroundTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@android:color/black"
        app:strokeColor="@android:color/black"
        app:strokeWidth="@dimen/spacing_2"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@android:color/white"
        android:id="@+id/btnTurnOnLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_12"
        android:text="@string/turn_on"
        android:textAllCaps="false"
        app:backgroundTint="@color/location_success_green"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_location_pin_24"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="@color/white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
