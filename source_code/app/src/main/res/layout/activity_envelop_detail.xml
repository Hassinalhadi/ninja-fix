<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_envelop_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:title="@string/notifications"
                style="@style/ToolbarStyle"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:padding="@dimen/spacing_12"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/spacing_12"
                android:transitionName="@string/anim_root">
                <ImageView
                    android:tag="binding_1"
                    android:padding="@dimen/spacing_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:transitionName="@string/anim_name_logo"/>
                <TextView
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:tag="binding_2"
                    android:padding="@dimen/spacing_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.4"
                    style="@style/Body1"/>
                <TextView
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:id="@+id/tvMessage"
                    android:tag="binding_3"
                    android:padding="@dimen/spacing_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Body1"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
