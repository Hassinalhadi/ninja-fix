<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_12"
    android:paddingBottom="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/coolgray_800"
        android:id="@+id/tv_select_address_type_title"
        android:paddingBottom="@dimen/spacing_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_address_type"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/container_building"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <include
                android:id="@+id/box_building"
                layout="@layout/item_address_type_box"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/container_villa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_12">
            <include
                android:id="@+id/box_villa"
                layout="@layout/item_address_type_box"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/container_business"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <include
                android:id="@+id/box_business"
                layout="@layout/item_address_type_box"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:weightSum="3">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/container_compound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <include
                android:id="@+id/box_compound"
                layout="@layout/item_address_type_box"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/container_other"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12">
            <include
                android:id="@+id/box_other"
                layout="@layout/item_address_type_box"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12"/>
    </LinearLayout>
</LinearLayout>
