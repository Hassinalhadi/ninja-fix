<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:orientation="vertical"
            android:background="@drawable/rounded_box"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_zero"
            android:layout_margin="@dimen/spacing_12"
            app:layout_constraintBottom_toTopOf="@+id/btnShareReferralLink"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/text_size_x_small_2x"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_25"
                    android:text="@string/refer_your_friends_and_earn"
                    android:layout_marginStart="@dimen/spacing_43"
                    android:layout_marginEnd="@dimen/spacing_43"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_25"
                    android:src="@drawable/ic_gift_illustration_referal"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:background="@drawable/referal_code_bg"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_25">
                    <TextView
                        android:textSize="@dimen/text_size_xx_tiny_extra"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:id="@+id/tvCode"
                        android:padding="@dimen/spacing_6"
                        android:layout_width="@dimen/spacing_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_6"/>
                    <TextView
                        android:textSize="@dimen/text_size_xx_tiny_extra"
                        android:textColor="@android:color/white"
                        android:id="@+id/btnCopy"
                        android:background="@drawable/copy_btn_bg"
                        android:paddingLeft="@dimen/spacing_12"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingRight="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@android:string/copy"
                        android:drawablePadding="@dimen/spacing_12"
                        android:paddingHorizontal="@dimen/spacing_12"
                        android:paddingVertical="@dimen/spacing_12"
                        app:drawableStartCompat="@drawable/ic_copy_icon"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:id="@+id/tvShareMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_25"
                    android:alpha="0.6"
                    android:layout_marginStart="@dimen/spacing_25"
                    android:layout_marginEnd="@dimen/spacing_25"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:id="@+id/btnShareReferralLink"
            android:padding="@dimen/spacing_12"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_12"
            android:text="@string/refer_friend_now"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/spacing_6"
            app:icon="@drawable/ic_send"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
