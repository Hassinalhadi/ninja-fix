<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:id="@+id/toolbar"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/spacing_3"
        app:titleTextColor="@android:color/white"
        style="@style/ToolbarStyle"/>
    <WebView
        android:textSize="@dimen/text_size_xxx_small"
        android:id="@+id/htmlContentTextView"
        android:padding="@dimen/spacing_12"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_zero"
        android:layout_above="@+id/footerLayout"
        android:layout_below="@+id/toolbar"
        android:lineSpacingExtra="@dimen/spacing_3"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/footerLayout"
        android:paddingLeft="@dimen/spacing_12"
        android:paddingRight="@dimen/spacing_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <CheckBox
            android:id="@+id/checkBoxAgree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/agree_terms"
            android:layout_marginStart="@dimen/spacing_11"/>
        <com.google.android.material.button.MaterialButton
            android:enabled="false"
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textColor="@android:color/white"
            android:id="@+id/buttonNext"
            android:padding="@dimen/spacing_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:text="@string/next"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/activity_vertical_margin"
            android:layout_marginEnd="@dimen/activity_vertical_margin"
            app:backgroundTint="@color/black"/>
    </LinearLayout>
</RelativeLayout>
