<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_agreement_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:background="@drawable/transaction_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6">
        <TextView
            android:textSize="@dimen/text_size_xxx_small"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:id="@+id/agreementName"
            android:tag="binding_1"
            android:paddingTop="@dimen/spacing_6"
            android:paddingBottom="@dimen/spacing_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textColor="@android:color/black"
            android:id="@+id/signedDate"
            android:tag="binding_2"
            android:paddingBottom="@dimen/spacing_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/agreementName"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
