<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_earn_your_money_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/register_new_captain"
        style="@style/ToolbarStyle"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_zero"
        app:layout_constraintBottom_toTopOf="@+id/cvContinueButton"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="@dimen/spacing_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/earn_your_money"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/secondary_text"
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_how_you_will_receive_your_money_immediately_after_completing_the_work"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
            <TextView
                android:textSize="@dimen/text_size_xxx_small"
                android:textColor="@color/black"
                android:id="@+id/tvUrPayHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/urpay_section_header"
                android:textFontWeight="600"
                app:layout_constraintTop_toBottomOf="@+id/tvDescription"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ilUrPay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="@string/hint_iban"
                android:layoutDirection="ltr"
                app:helperText="@string/helper_iban_saudi"
                app:layout_constraintTop_toBottomOf="@+id/tvUrPayHeader"
                app:prefixTextColor="@color/dark_gray_3"
                style="@style/InputLayoutStyle.SignUp.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:id="@+id/etUrPay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxEms="20"
                    android:maxLength="34"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionNext"
                    android:layoutDirection="ltr"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ilUrPayId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="@string/hint_urpay_mobile"
                android:layoutDirection="ltr"
                app:helperText="@string/helper_urpay_mobile"
                app:layout_constraintTop_toBottomOf="@+id/ilUrPay"
                app:prefixTextColor="@color/dark_gray_3"
                style="@style/InputLayoutStyle.SignUp.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:id="@+id/etUrPayId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxEms="30"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:layoutDirection="ltr"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="@dimen/text_size_xxx_small"
                android:textColor="@color/black"
                android:id="@+id/tvBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_25"
                android:text="@string/bank_optional"
                android:textFontWeight="600"
                app:layout_constraintTop_toBottomOf="@+id/ilUrPayId"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ilBankNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="@string/iban_number"
                app:layout_constraintTop_toBottomOf="@+id/tvBank"
                style="@style/InputLayoutStyle.SignUp.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:id="@+id/etBankNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxEms="20"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ilBankName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="@string/bank_name"
                app:layout_constraintTop_toBottomOf="@+id/ilBankNumber"
                style="@style/InputLayoutStyle.SignUp.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:id="@+id/etBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_arrow_down_24"
                    android:textDirection="locale"
                    android:drawableTint="@color/signup_input_layout_color"
                    style="@style/NonEditableFieldsStyle"/>
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvContinueButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/spacing_6"
        app:contentPaddingBottom="@dimen/spacing_2"
        app:contentPaddingLeft="@dimen/spacing_12"
        app:contentPaddingRight="@dimen/spacing_12"
        app:contentPaddingTop="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/text_size_xx_tiny_extra"
            android:textColor="@color/btn_black_text_color"
            android:layout_gravity="center"
            android:id="@+id/btnSubmit"
            android:padding="@dimen/spacing_9"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/submit_your_application"
            android:textAllCaps="false"
            android:textFontWeight="600"
            app:backgroundTint="@color/btn_black_background_tint"
            app:cornerRadius="@dimen/spacing_6"/>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
