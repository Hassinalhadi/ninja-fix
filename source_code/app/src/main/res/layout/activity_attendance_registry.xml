<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_attendance_registry_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="@string/anim_root">
    <androidx.cardview.widget.CardView
        android:id="@+id/qrCardView"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_15"
        android:animateLayoutChanges="true"
        app:cardBackgroundColor="@color/color_light_blue"
        app:cardCornerRadius="@dimen/spacing_12"
        app:cardElevation="@dimen/spacing_zero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="@dimen/spacing_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_large"
                android:id="@+id/title"
                android:layout_width="@dimen/spacing_zero"
                android:layout_height="wrap_content"
                android:text="@string/scan_qr_code"
                app:layout_constraintEnd_toStartOf="@+id/btnQrCode"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Body2"/>
            <TextView
                android:textSize="@dimen/text_size_x_small"
                android:id="@+id/description"
                android:layout_width="@dimen/spacing_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:text="@string/description_qr_message"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnQrCode"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/Body2"/>
            <ImageButton
                android:id="@+id/btnQrCode"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/spacing_6"
                android:layout_width="@dimen/spacing_135"
                android:layout_height="@dimen/spacing_135"
                android:layout_marginBottom="@dimen/spacing_12"
                android:src="@drawable/phoneqr"
                android:scaleType="fitCenter"
                android:layout_marginEnd="@dimen/spacing_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
