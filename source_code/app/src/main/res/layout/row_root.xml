<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/color_light_blue"
    app:cardCornerRadius="@dimen/spacing_6"
    app:cardElevation="@dimen/spacing_zero">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/actionImage"
            android:layout_width="@dimen/spacing_25"
            android:layout_height="@dimen/spacing_25"
            android:layout_margin="@dimen/spacing_12"
            android:src="@drawable/ic_orders_list_indicator"
            app:layout_constraintBottom_toTopOf="@+id/expandableLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatCheckedTextView
            android:gravity="start|center_vertical"
            android:id="@+id/rootName"
            android:background="?attr/selectableItemBackground"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="?attr/actionBarSize"
            android:text="@string/orders"
            android:drawablePadding="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_12"
            app:layout_constraintBottom_toTopOf="@+id/expandableLayout"
            app:layout_constraintEnd_toEndOf="@+id/groupIndicator"
            app:layout_constraintStart_toEndOf="@+id/actionImage"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Body2_medium"/>
        <ImageButton
            android:id="@+id/groupIndicator"
            android:padding="@dimen/spacing_6"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/group_indicator"
            app:layout_constraintBottom_toTopOf="@+id/expandableLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/toolbarNavigationButtonStyle"/>
        <net.cachapa.expandablelayout.ExpandableLayout
            android:id="@+id/expandableLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:el_expanded="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rootName">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/actionsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
        </net.cachapa.expandablelayout.ExpandableLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
