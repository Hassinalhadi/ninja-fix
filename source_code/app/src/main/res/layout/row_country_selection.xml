<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_country_selection_0"
    android:padding="@dimen/spacing_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_6">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvFlag"
        android:tag="binding_1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/spacing_18"
        android:layout_height="@dimen/spacing_18"
        app:cardCornerRadius="@dimen/spacing_9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/text_size_x_large"
            android:gravity="center"
            android:layout_gravity="center"
            android:tag="binding_2"
            android:layout_width="@dimen/spacing_23"
            android:layout_height="@dimen/spacing_23"/>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:textColor="@color/black"
        android:id="@+id/tvCountryName"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_6"
        app:layout_constraintStart_toEndOf="@+id/cvFlag"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iconFavorite"
        android:tag="binding_4"
        android:layout_width="@dimen/spacing_18"
        android:layout_height="@dimen/spacing_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
