<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/row_order_complete_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_large"
        android:id="@+id/taskName"
        android:padding="@dimen/spacing_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_6"
        android:text="@string/deliver_to"
        android:textFontWeight="600"
        style="@style/Body1"/>
    <TextView
        android:textSize="@dimen/text_size_xx_tiny_extra"
        android:id="@+id/tvDebugProximity"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_4"
        android:layout_marginStart="@dimen/spacing_6"
        android:layout_marginEnd="@dimen/spacing_6"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/rounded_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_6"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_12">
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="@dimen/spacing_18"
            android:layout_height="@dimen/spacing_18"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_location_icon"/>
        <TextView
            android:textSize="@dimen/text_size_large"
            android:id="@+id/title"
            android:layout_width="@dimen/spacing_zero"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_6"
            android:layout_marginEnd="@dimen/spacing_12"
            android:textFontWeight="600"
            app:layout_constraintStart_toEndOf="@+id/imageView2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Body2"/>
        <ImageView
            android:id="@+id/expandIcon"
            android:layout_width="@dimen/spacing_21"
            android:layout_height="@dimen/spacing_21"
            android:layout_marginTop="@dimen/spacing_6"
            android:src="@drawable/ic_arrow_down_24"
            android:layout_marginEnd="@dimen/spacing_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_xx_large"
            android:textStyle="bold"
            android:textColor="@color/colorGreen"
            android:gravity="center"
            android:id="@+id/tv_eta"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_eta">
            <TextView
                android:textSize="@dimen/text_size_xxx_small"
                android:textColor="@color/black_70"
                android:id="@+id/tvAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/spacing_36"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/imagesRecyclerView"
                android:visibility="gone"
                android:scrollbars="horizontal"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_12"
                android:paddingStart="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_12"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAddress"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:id="@+id/openMapButton"
                android:tag="binding_2"
                android:padding="@dimen/spacing_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/view_map"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_12"
                android:tooltipText="@string/open_direction_in_map"
                app:icon="@drawable/ic_map_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imagesRecyclerView"
                style="@style/OrderProcessingTextActionButtonStyle2"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clNotes"
                android:background="@drawable/dashed_border"
                android:padding="@dimen/spacing_6"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_12"
                android:layout_marginRight="@dimen/spacing_12"
                android:layout_marginHorizontal="@dimen/spacing_12"
                app:layout_constraintTop_toBottomOf="@+id/openMapButton">
                <ImageView
                    android:id="@+id/ivAddNoteIcon"
                    android:layout_width="@dimen/spacing_18"
                    android:layout_height="@dimen/spacing_18"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_address_note"/>
                <TextView
                    android:textSize="@dimen/text_size_xxx_small"
                    android:id="@+id/tvAddNoteTitle"
                    android:layout_width="@dimen/spacing_zero"
                    android:layout_height="wrap_content"
                    android:text="@string/notes"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:textFontWeight="600"
                    app:layout_constraintBottom_toBottomOf="@+id/ivAddNoteIcon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/ivAddNoteIcon"
                    app:layout_constraintTop_toTopOf="@+id/ivAddNoteIcon"
                    style="@style/Body2"/>
                <TextView
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:textColor="@color/black_70"
                    android:id="@+id/tvNoteDesc"
                    android:layout_width="@dimen/spacing_zero"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_6"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/tvAddNoteTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvAddNoteTitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAddressNotesCards"
                android:visibility="gone"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="600dp"
                android:layout_marginTop="@dimen/spacing_4"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/clNotes"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clTakeProof"
                android:background="@drawable/dashed_border"
                android:padding="@dimen/spacing_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_12"
                android:layout_marginTop="@dimen/spacing_8"
                android:layout_marginRight="@dimen/spacing_12"
                android:layout_marginHorizontal="@dimen/spacing_12"
                app:layout_constraintTop_toBottomOf="@+id/rvAddressNotesCards">
                <ImageView
                    android:id="@+id/ivTakeProofIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/black"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tvTakeProofTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/take_a_photo"
                    android:fontFamily="@font/cko_roboto_bold"
                    android:layout_marginStart="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivTakeProofIcon"
                    app:layout_constraintTop_toTopOf="@+id/ivTakeProofIcon"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:id="@+id/tvTakeProofSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/take_proof_description"
                    android:fontFamily="@font/cko_roboto_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tvTakeProofTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvTakeProofTitle"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="@dimen/text_size_xx_tiny_extra"
                    android:id="@+id/btnTakeProofPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/take_proof_photo"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_camera"
                    app:layout_constraintTop_toBottomOf="@+id/tvTakeProofSubtitle"
                    style="@style/OrderProcessingTextActionButtonStyle2"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProofImages"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="@dimen/spacing_12"
                    android:paddingEnd="@dimen/spacing_12"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/btnTakeProofPhoto"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#dc2626"
                android:gravity="center"
                android:id="@+id/tvProofMessage"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/proof_success_message"
                android:fontFamily="@font/cko_roboto_bold"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_marginEnd="@dimen/spacing_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clTakeProof"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:id="@+id/btnCallCustomer"
                android:tag="binding_3"
                android:paddingTop="@dimen/spacing_9"
                android:paddingBottom="@dimen/spacing_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/call_customer"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_12"
                android:paddingVertical="@dimen/spacing_9"
                app:icon="@drawable/ic_call_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvProofMessage"
                style="@style/OrderProcessingTextActionButtonStyle2"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="normal"
                android:textColor="@color/colorRed"
                android:gravity="center"
                android:id="@+id/tvBeInstructionMessage"
                android:tag="binding_4"
                android:background="@drawable/bg_warning_border"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:lineSpacingExtra="@dimen/_4sdp"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnCallCustomer"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:gravity="center"
                android:id="@+id/btnProcessOrder"
                android:padding="@dimen/spacing_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_12"
                app:iconTint="@android:color/transparent"
                app:iconTintMode="add"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBeInstructionMessage"
                style="@style/OrderProcessingTextActionButtonStyle"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="@dimen/text_size_xx_tiny_extra"
                android:id="@+id/btnItems"
                android:tag="binding_5"
                android:padding="@dimen/spacing_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:text="@string/items"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_12"
                app:icon="@drawable/ic_list_icon"
                app:iconTint="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnProcessOrder"
                style="@style/OrderProcessingTextActionButtonStyle2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
