<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fragment
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:id="@+id/zonesMap"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="@dimen/spacing_zero"
        app:layout_constraintBottom_toTopOf="@+id/tvCurrentArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textColor="@color/darker_gray"
        android:id="@+id/tvCurrentArea"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_12"
        android:text="@string/current_area"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/zonesMap"/>
    <TextView
        android:textSize="@dimen/text_size_xxx_small"
        android:textColor="@color/colorGreen"
        android:id="@+id/tvCurrentAreaValue"
        android:layout_width="@dimen/spacing_zero"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="@+id/tvCurrentArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvCurrentArea"/>
</androidx.constraintlayout.widget.ConstraintLayout>
