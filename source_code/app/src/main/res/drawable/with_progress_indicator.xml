<?xml version="1.0" encoding="utf-8"?>
<level-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:minLevel="0"
        android:maxLevel="0">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/spacing_12"/>
        </shape>
    </item>
    <item
        android:minLevel="1"
        android:maxLevel="1">
        <layer-list>
            <item
                android:height="@dimen/spacing_37"
                android:width="@dimen/spacing_37">
                <shape
                    android:tint="#ff8000"
                    android:shape="rectangle">
                    <corners android:radius="@dimen/spacing_12"/>
                </shape>
            </item>
            <item
                android:gravity="center"
                android:drawable="@drawable/ic_clock_icon"/>
        </layer-list>
    </item>
    <item
        android:minLevel="2"
        android:maxLevel="2">
        <layer-list>
            <item
                android:height="@dimen/spacing_37"
                android:width="@dimen/spacing_37">
                <shape
                    android:tint="#36a315"
                    android:shape="rectangle">
                    <corners android:radius="@dimen/spacing_12"/>
                </shape>
            </item>
            <item
                android:gravity="center"
                android:drawable="@drawable/ic_done_24"/>
        </layer-list>
    </item>
    <item
        android:minLevel="3"
        android:maxLevel="3">
        <layer-list>
            <item
                android:height="@dimen/spacing_37"
                android:width="@dimen/spacing_37">
                <shape
                    android:tint="#1656ca"
                    android:shape="rectangle">
                    <corners android:radius="@dimen/spacing_12"/>
                </shape>
            </item>
            <item
                android:gravity="center"
                android:drawable="@drawable/ic_transferred_icon"/>
        </layer-list>
    </item>
    <item
        android:minLevel="4"
        android:maxLevel="4">
        <layer-list>
            <item
                android:height="@dimen/spacing_37"
                android:width="@dimen/spacing_37">
                <shape
                    android:tint="#df1d1d"
                    android:shape="rectangle">
                    <corners android:radius="@dimen/spacing_12"/>
                </shape>
            </item>
            <item
                android:gravity="center"
                android:drawable="@drawable/ic_rejected_icon"/>
        </layer-list>
    </item>
    <item
        android:minLevel="5"
        android:maxLevel="5">
        <layer-list>
            <item
                android:height="@dimen/spacing_37"
                android:width="@dimen/spacing_37">
                <shape
                    android:tint="#5d5d5d"
                    android:shape="rectangle">
                    <corners android:radius="@dimen/spacing_12"/>
                </shape>
            </item>
            <item
                android:gravity="center"
                android:drawable="@drawable/ic_failed_icon"/>
        </layer-list>
    </item>
    <item
        android:minLevel="6"
        android:maxLevel="6">
        <layer-list>
            <item
                android:height="@dimen/spacing_37"
                android:width="@dimen/spacing_37">
                <shape
                    android:tint="#12a5f1"
                    android:shape="rectangle">
                    <corners android:radius="@dimen/spacing_12"/>
                </shape>
            </item>
            <item
                android:gravity="center"
                android:drawable="@drawable/ic_processing_icon"/>
        </layer-list>
    </item>
</level-list>
